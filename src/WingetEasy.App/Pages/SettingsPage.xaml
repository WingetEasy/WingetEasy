<Page
    x:Class="WingetEasy.App.Pages.SettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Stretch">

            <TextBlock Text="Configurações" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,24" />

            <TextBlock Text="Verificação de atualizações" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Frequência" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="Com que frequência o WingetEasy deve procurar updates" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.FrequencyOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFrequencyOption, Mode=TwoWay}"
                                  MinWidth="200" VerticalAlignment="Center" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Horário da verificação" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <TimePicker Grid.Column="1" SelectedTime="{x:Bind ViewModel.CheckTime, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsScheduleTimeEditable, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Sistema e Aparência" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Iniciar com o Windows" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="Abre o WingetEasy silenciosamente na bandeja do sistema" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,-8,0" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tema do aplicativo" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="Claro" />
                            <ComboBoxItem Content="Escuro" />
                            <ComboBoxItem Content="Sistema" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Pacotes ignorados" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0">
                <ListView ItemsSource="{x:Bind ViewModel.IgnoredPackages}"
                          SelectionMode="None" ShowsScrollingPlaceholders="False"
                          MaxHeight="250">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="16,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                                <Button Grid.Column="1" Content="Restaurar" Style="{StaticResource DefaultButtonStyle}"
                                        CommandParameter="{x:Bind}"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveIgnoredPackageCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock Text="Windows Package Manager" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <InfoBar IsOpen="True" IsClosable="False" CornerRadius="8"
                     Severity="{x:Bind ViewModel.WingetInfoBarSeverity, Mode=OneWay}"
                     Title="Winget"
                     Message="{x:Bind ViewModel.WingetStatusMessage, Mode=OneWay}" />

            <TextBlock Text="Sobre" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AppUpdateStatusMessage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="GitHub" Command="{x:Bind ViewModel.OpenGitHubCommand}" />
                        <Button Content="Verificar atualizações" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CheckForAppUpdateCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
