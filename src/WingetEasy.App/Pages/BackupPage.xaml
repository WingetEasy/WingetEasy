<Page
    x:Class="WingetEasy.App.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock Text="Backup e restauração"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Salve os pacotes instalados e restaure-os quando precisar."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding LabelInput, Mode=TwoWay}"
                         PlaceholderText="Rótulo opcional do snapshot"/>
                <Button Grid.Column="1"
                        Content="Criar Snapshot Agora"
                        AutomationProperties.Name="Criar Snapshot Agora"
                        Command="{Binding CreateSnapshotCommand}"
                        Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>
            <InfoBar IsOpen="{Binding IsStatusVisible}"
                     Message="{Binding StatusMessage}"
                     Severity="Informational"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView ItemsSource="{Binding Snapshots}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,0,0,10"
                                CornerRadius="10"
                                Background="{ThemeResource SurfaceCardBackgroundBrush}"
                                BorderBrush="{ThemeResource SurfaceCardBorderBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CreatedAt}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{Binding PackageCount}"/>
                                        <TextBlock Text="{Binding WingetVersion}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="Restaurar"
                                            Click="RestoreButton_Click"/>
                                    <Button Content="Exportar .ps1"
                                            Click="ExportScriptButton_Click"/>
                                    <Button Content="Exportar .json"
                                            Click="ExportJsonButton_Click"/>
                                    <Button Content="Exportar como Perfil"
                                            Click="CreateProfileButton_Click"/>
                                    <Button Content="Excluir"
                                            Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Visibility="{Binding EmptyStateVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE74E;"
                          FontSize="36"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Nenhum snapshot salvo ainda."
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Crie um snapshot para preservar os pacotes instalados."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                  Visibility="{Binding IsProgressVisible}">
                <StackPanel Width="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing IsActive="True"
                                  HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding ProgressValue}"
                                 Maximum="100"/>
                    <TextBlock Text="{Binding ProgressMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
