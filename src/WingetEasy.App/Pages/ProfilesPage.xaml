<Page
    x:Class="WingetEasy.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <TextBlock Text="Perfis de instalação" FontSize="28" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NameInput, Mode=TwoWay}" PlaceholderText="Nome"/>
                <TextBox Grid.Column="1" Text="{Binding DescriptionInput, Mode=TwoWay}" PlaceholderText="Descrição"/>
                <TextBox Grid.Column="2" Text="{Binding PackageIdsInput, Mode=TwoWay}" PlaceholderText="ID|Nome (um por linha)"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button Content="Salvar perfil" Command="{Binding SaveProfileCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="Cancelar" Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </Grid>
            <Button Content="Carregar pacotes instalados" Command="{Binding LoadInstalledPackagesCommand}" HorizontalAlignment="Left"/>
            <InfoBar IsOpen="{Binding IsStatusVisible}" Message="{Binding StatusMessage}" Severity="Informational"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <ListView ItemsSource="{Binding Profiles}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,0,0,10" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PackageSummary}"/>
                                    <TextBlock Text="{Binding Packages}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Instalar" Click="InstallButton_Click"/>
                                    <Button Content="Editar" Click="EditButton_Click"/>
                                    <Button Content="Excluir" Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8FD;" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="Nenhum perfil disponível." FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="Crie um perfil para instalar seus pacotes favoritos." HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Visibility="{Binding IsProgressVisible}" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100"/>
                    <TextBlock Text="{Binding ProgressMessage}" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
