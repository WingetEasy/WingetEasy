<Page
    x:Class="WingetEasy.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WingetEasy.App.ViewModels">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PeriodComboBox"
                      SelectedIndex="3"
                      SelectionChanged="PeriodComboBox_SelectionChanged">
                <ComboBoxItem Content="Hoje"/>
                <ComboBoxItem Content="7 dias"/>
                <ComboBoxItem Content="Mês"/>
                <ComboBoxItem Content="Tudo"/>
            </ComboBox>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     PlaceholderText="Buscar por nome ou ID do pacote"
                     TextChanged="SearchTextBox_TextChanged"/>
            <Button Grid.Column="2"
                    Content="Exportar CSV"
                    Command="{x:Bind ViewModel.ExportCsvCommand}"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryDayGroup">
                            <StackPanel Spacing="8" Margin="0,0,0,20">
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                            <Border Padding="12"
                                                    Margin="0,0,0,6"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind StatusGlyph}"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{x:Bind PackageName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind PackageId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{x:Bind VersionTransition}"/>
                                                        <TextBlock Text="{x:Bind ErrorMessage}"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{x:Bind StatusText}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Visibility="{x:Bind ViewModel.EmptyStateVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE81C;" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyStateMessage}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
