<Page
    x:Class="WingetEasy.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WingetEasy.App.ViewModels" Background="Transparent">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PeriodComboBox"
                      SelectedIndex="3"
                      SelectionChanged="PeriodComboBox_SelectionChanged">
                <ComboBoxItem Content="Hoje"/>
                <ComboBoxItem Content="7 dias"/>
                <ComboBoxItem Content="Mês"/>
                <ComboBoxItem Content="Tudo"/>
            </ComboBox>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     PlaceholderText="Buscar por nome ou ID do pacote"
                     TextChanged="SearchTextBox_TextChanged"/>
            <Button Grid.Column="2"
                    Content="Exportar CSV"
                    AutomationProperties.Name="Exportar histórico em CSV"
                    Command="{x:Bind ViewModel.ExportCsvCommand}"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryDayGroup">
                            <StackPanel Spacing="8" Margin="0,0,0,20">
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                            <Border Padding="14,12"
                                                    Margin="0,0,0,6"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource SurfaceCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SurfaceCardBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind StatusGlyph}"
                                                                  Visibility="{x:Bind IsSuccessVisible}"
                                                                  Foreground="{ThemeResource BadgeSuccessFgBrush}"
                                                                  FontSize="16"/>
                                                        <FontIcon Glyph="{x:Bind StatusGlyph}"
                                                                  Visibility="{x:Bind IsFailureVisible}"
                                                                  Foreground="{ThemeResource BadgeErrorFgBrush}"
                                                                  FontSize="16"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind PackageName}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource BrandTextPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind PackageId}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource BrandTextSecondaryBrush}"/>
                                                        <TextBlock Text="{x:Bind ErrorMessage}"
                                                                   Visibility="{x:Bind ErrorVisibility}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource BadgeErrorFgBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind VersionTransition}"
                                                               Visibility="{x:Bind VersionVisibility}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource BrandPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"/>
                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Spacing="10"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <Border Visibility="{x:Bind IsSuccessVisible}"
                                                                Background="{ThemeResource BadgeSuccessBgBrush}"
                                                                BorderBrush="{ThemeResource BadgeSuccessBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="8,2">
                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource BadgeSuccessFgBrush}"/>
                                                        </Border>
                                                        <Border Visibility="{x:Bind IsFailureVisible}"
                                                                Background="{ThemeResource BadgeErrorBgBrush}"
                                                                BorderBrush="{ThemeResource BadgeErrorBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="8,2">
                                                            <TextBlock Text="{x:Bind StatusText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource BadgeErrorFgBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Time}"
                                                                   FontSize="12.5"
                                                                   Foreground="{ThemeResource BrandTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE81C;" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
