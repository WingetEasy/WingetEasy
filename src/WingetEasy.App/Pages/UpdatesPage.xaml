<Page
    x:Class="WingetEasy.App.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WingetEasy.App.Views.Controls"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Buscar por nome ou ID"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1"
                        Content="Buscar atualizações"
                        Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Categoria:" VerticalAlignment="Center"/>
                <ToggleButton Content="Todos" Tag="Todos" IsChecked="True" Click="CategoryFilter_Click"/>
                <ToggleButton Content="App" Tag="App" Click="CategoryFilter_Click"/>
                <ToggleButton Content="Runtime" Tag="Runtime" Click="CategoryFilter_Click"/>
                <ToggleButton Content="Segurança" Tag="Segurança" Click="CategoryFilter_Click"/>
                <ComboBox Width="140"
                          SelectedIndex="0"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Nome (A-Z)"/>
                    <ComboBoxItem Content="Categoria"/>
                    <ComboBoxItem Content="Fonte"/>
                </ComboBox>
            </StackPanel>
            <ProgressBar Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsUpdatingVisibility}"
                         Maximum="100"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>
            <TextBlock Visibility="{x:Bind ViewModel.IsUpdatingVisibility}"
                       Text="{x:Bind ViewModel.BatchStatus, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.IsUpdateSummaryVisible, Mode=OneWay}"
                     Severity="Informational"
                     Title="Resumo da atualização"
                     Message="{x:Bind ViewModel.UpdateSummary, Mode=OneWay}"/>
        </StackPanel>

        <!-- A Lista que renderiza o nosso novo controle -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Packages}"
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:PackageItemControl />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
