<Page
    x:Class="WingetEasy.App.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WingetEasy.App.Views.Controls"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Botão temporário para carregar os nossos mocks -->
        <Button Grid.Row="0"
                Content="Buscar Atualizações (Teste)"
                Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Margin="0,0,0,16"/>

        <!-- A Lista que renderiza o nosso novo controle -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Packages}"
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:PackageItemControl />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
