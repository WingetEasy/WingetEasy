        <!-- Tema Claro (Light) -->
        <ResourceDictionary x:Key="Light">
            <!-- Brand & Accent (WingetEasy Design Tokens - Light) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#1F3B82F6" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#80F3F6FC" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#80F0F4F9" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#66F0F4F9" />
            <SolidColorBrush x:Key="MainAreaBackgroundBrush" Color="#66F8FAFC" />
            <SolidColorBrush x:Key="AcrylicFlyoutBackgroundBrush" Color="#80F8FAFC" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#475569" />
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#64748B" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#16A34A" />

            <!-- Navegação e Segmented -->
            <SolidColorBrush x:Key="NavItemHoverBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SegmentedThumbBrush" Color="#FFFFFF" />

            <!-- Superfícies de Cards e Bordas -->
            <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardSecondaryBackgroundBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SurfaceCardStrongBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SurfaceLayerFillBrush" Color="#80F8FAFC" />

            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="PackageCardBorderBrush" Color="#E2E8F0" />

            <!-- Badges Semânticos (Sucesso, Alerta, Erro) -->
            <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#1F16A34A" />
            <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D16A34A" />

            <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#FFF3E0" />
            <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="BadgeWarningBorderBrush" Color="#66D97706" />

            <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#FFEBEB" />
            <SolidColorBrush x:Key="BadgeErrorFgBrush" Color="#D92D2D" />
            <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#66D92D2D" />

