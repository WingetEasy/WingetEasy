<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Tema Escuro (Default) -->
        <ResourceDictionary x:Key="Default">
            <!-- Brand & Accent (WingetEasy Design Tokens - Dark) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#293B82F6" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#8024242A" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#8026262C" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#66242631" />
            <SolidColorBrush x:Key="MainAreaBackgroundBrush" Color="#8a1d1d1d" />
            <SolidColorBrush x:Key="AcrylicFlyoutBackgroundBrush" Color="#802B2B31" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#802B2B31" />
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#F5F7FC" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#A4A4AE" />
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#80808B" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#34D399" />

            <!-- Navegação e Segmented -->
            <SolidColorBrush x:Key="NavItemHoverBrush" Color="#343440" />
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#3A3A49" />
            <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#202027" />
            <SolidColorBrush x:Key="SegmentedThumbBrush" Color="#343440" />

            <!-- Superfícies de Cards e Bordas -->
            <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="#802B2B31" />
            <SolidColorBrush x:Key="SurfaceCardSecondaryBackgroundBrush" Color="#80303039" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#3D3D48" />
            <SolidColorBrush x:Key="SurfaceCardStrongBorderBrush" Color="#50505D" />
            <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#383842" />
            <SolidColorBrush x:Key="SurfaceLayerFillBrush" Color="#8024242A" />

            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#662B2B31" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#80343440" />
            <SolidColorBrush x:Key="PackageCardBorderBrush" Color="#3D3D48" />

            <!-- Badges Semânticos (Sucesso, Alerta, Erro) -->
            <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#2934D399" />
            <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#34D399" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D34D399" />

            <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeWarningBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeErrorFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#66FF6B6B" />

            <!-- Badges de Categorias (Segurança, Runtime, App) -->
            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeSecurityBorderBrush" Color="#66FF6B6B" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeRuntimeBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#1E2E4A" />
            <SolidColorBrush x:Key="BadgeAppFgBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BadgeAppBorderBrush" Color="#663B82F6" />
        </ResourceDictionary>

        <!-- Tema Escuro (Dark) -->
        <ResourceDictionary x:Key="Dark">
            <!-- Brand & Accent (WingetEasy Design Tokens - Dark) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
