            <SolidColorBrush x:Key="BadgeAppBorderBrush" Color="#663B82F6" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">12</CornerRadius>

    <LinearGradientBrush x:Key="HeroBannerGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#3F5FBE" Offset="0.0" />
        <GradientStop Color="#4A78EB" Offset="0.48" />
        <GradientStop Color="#743CE7" Offset="1.0" />
    </LinearGradientBrush>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceCardStrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource BrandTextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeroWhiteButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#1E3A8A" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeroGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#DC2626" />
        <Setter Property="BorderBrush" Value="#B91C1C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
