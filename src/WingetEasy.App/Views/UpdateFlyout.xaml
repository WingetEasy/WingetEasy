<Window
    x:Class="WingetEasy.App.Views.UpdateFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WingetEasy.App.ViewModels"
    Title="WingetEasy">

    <Border x:Name="RootGrid"
            CornerRadius="12"
            Loaded="RootGrid_Loaded"
            Background="{ThemeResource SurfaceCardBackgroundBrush}"
            BorderBrush="{ThemeResource SurfaceCardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOPO: Logo W + WingetEasy + Bolinha colorida de status + Botão Engrenagem ⚙ -->
            <Grid Grid.Row="0" Padding="14,14,14,10" ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="ms-appx:///Assets/WingetEasy-Logo.png"
                       Width="30"
                       Height="30"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WingetEasy"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandTextPrimaryBrush}" />

                    <!-- Status com atualizações disponíveis (Azul) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#3B82F6"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.FlyoutStatusText, Mode=OneWay}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="#3B82F6"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status tudo atualizado (Verde) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{ThemeResource BrandSuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Tudo atualizado"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource BrandSuccessBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons"
                        AutomationProperties.Name="Abrir configurações"
                        ToolTipService.ToolTip="Configurações"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{ThemeResource BrandTextSecondaryBrush}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="7"
                        VerticalAlignment="Center"
                        Click="SettingsButton_Click" />
            </Grid>

            <!-- CORPO (2 estados: Com atualizações vs Tudo atualizado) -->
            <Grid Grid.Row="1" Padding="10,2,10,8">
                <!-- Estado 1: Há atualizações (até 4 pacotes + "+ X outros pacotes") -->
                <StackPanel Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}" Spacing="2">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FlyoutPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackageItemViewModel">
                                <Border Padding="8,7" CornerRadius="7" Background="Transparent">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Background="{x:Bind IconBrush, Mode=OneWay}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Initials, Mode=OneWay}"
                                                       Foreground="White"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name, Mode=OneWay}"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource BrandTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind AvailableVersion, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#3B82F6"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind ViewModel.FlyoutMoreText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.FlyoutMoreVisibility, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{ThemeResource BrandTextSecondaryBrush}"
                               Margin="10,4,10,2" />
                </StackPanel>

                <!-- Estado 2: Tudo atualizado (Círculo verde com check ✓ + mensagem) -->
                <Grid Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}"
                      Padding="8,12,8,14"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{ThemeResource BadgeSuccessBgBrush}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="20"
                                  Foreground="{ThemeResource BrandSuccessBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Seu sistema está em dia."
                                   FontSize="12.5"
                                   Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RODAPÉ -->
            <Border Grid.Row="2"
                    Padding="12,10,12,12"
                    BorderBrush="{ThemeResource SurfaceDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Botões quando há atualizações: "Atualizar tudo" (azul) + "Abrir" (secundário) -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Atualizar tudo"
                                Command="{x:Bind ViewModel.UpdateAllCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="34"
                                Padding="12,0"
                                FontSize="12.5" />

                        <Button Grid.Column="1"
                                Content="Abrir"
                                Click="OpenButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="34"
                                Padding="12,0"
                                FontSize="12.5" />
                    </Grid>

                    <!-- Botão quando está tudo atualizado: "Verificar agora" ocupando toda a largura -->
                    <Button Content="Verificar agora"
                            Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                            Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            FontSize="12.5" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
