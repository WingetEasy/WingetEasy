<Window
    x:Class="WingetEasy.App.Views.UpdateFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WingetEasy.App.ViewModels"
    Title="WingetEasy">

    <Border x:Name="RootGrid"
            CornerRadius="12"
            Loaded="RootGrid_Loaded"
            Background="{ThemeResource SurfaceCardBackgroundBrush}"
            BorderBrush="{ThemeResource SurfaceCardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOPO: Logo W + WingetEasy + Bolinha colorida de status + Configurações + Fechar -->
            <Grid Grid.Row="0" Padding="14,14,14,10" ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="ms-appx:///Assets/WingetEasy-Logo.png"
                       Width="30"
                       Height="30"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WingetEasy"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandTextPrimaryBrush}" />

                    <!-- Status com atualizações disponíveis (Azul) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#3B82F6"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.FlyoutStatusText, Mode=OneWay}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="#3B82F6"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status tudo atualizado (Verde) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{ThemeResource BrandSuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Tudo atualizado"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource BrandSuccessBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Content="&#xE713;"
                            FontFamily="Segoe Fluent Icons"
                            AutomationProperties.Name="Abrir configurações"
                            ToolTipService.ToolTip="Configurações"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{ThemeResource BrandTextSecondaryBrush}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="7"
                            Click="SettingsButton_Click" />

                    <Button Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            AutomationProperties.Name="Fechar"
                            ToolTipService.ToolTip="Fechar"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{ThemeResource BrandTextSecondaryBrush}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="7"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- CORPO (2 estados: Com atualizações vs Tudo atualizado) -->
            <Grid Grid.Row="1" Padding="10,2,10,8">
                <!-- Estado 1: Há atualizações com rolagem e checkboxes de seleção -->
                <Grid Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card de status da atualização em andamento (Aparece por cima da lista no momento do clique) -->
                    <Border Grid.Row="0"
                            Visibility="{x:Bind ViewModel.IsUpdatingVisibility, Mode=OneWay}"
                            Background="{ThemeResource BrandAccentSoftBrush}"
                            BorderBrush="#333B82F6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing Grid.Column="0"
                                          IsActive="True"
                                          Width="16"
                                          Height="16"
                                          Foreground="#3B82F6"
                                          VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.CurrentUpdatingPackageDisplay, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource BrandTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <ProgressBar Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}"
                                             Maximum="100"
                                             Height="3"
                                             Foreground="#3B82F6" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.BatchStatusDisplay, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#3B82F6"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Lista de pacotes com rolagem suave -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="290"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FlyoutPackages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PackageItemViewModel">
                                    <Border Padding="6,6" CornerRadius="7" Background="Transparent">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind IsPending, Mode=OneWay}"
                                                      MinWidth="0"
                                                      Padding="0"
                                                      AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="7"
                                                    Background="{x:Bind IconBrush, Mode=OneWay}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Initials, Mode=OneWay}"
                                                           Foreground="White"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Name, Mode=OneWay}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Foreground="{ThemeResource BrandTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       VerticalAlignment="Center" />

                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <!-- Versão quando pendente -->
                                                <TextBlock Text="{x:Bind AvailableVersion, Mode=OneWay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#3B82F6"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsPendingVisible, Mode=OneWay}" />

                                                <!-- Spinner durante atualização deste pacote -->
                                                <ProgressRing IsActive="True"
                                                              Width="14"
                                                              Height="14"
                                                              Foreground="#3B82F6"
                                                              VerticalAlignment="Center"
                                                              Visibility="{x:Bind IsProgressVisibility, Mode=OneWay}" />

                                                <!-- Ícone check ao concluir -->
                                                <FontIcon Glyph="&#xE73E;"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource BrandSuccessBrush}"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsCompletedVisible, Mode=OneWay}" />

                                                <!-- Ícone ao falhar -->
                                                <FontIcon Glyph="&#xE783;"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource BadgeErrorFgBrush}"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind IsFailedVisible, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Estado 2: Tudo atualizado (Círculo verde com check ✓ + mensagem) -->
                <Grid Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}"
                      Padding="8,12,8,14"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{ThemeResource BadgeSuccessBgBrush}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="20"
                                  Foreground="{ThemeResource BrandSuccessBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Seu sistema está em dia."
                                   FontSize="12.5"
                                   Foreground="{ThemeResource BrandTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RODAPÉ -->
            <Border Grid.Row="2"
                    Padding="12,10,12,12"
                    BorderBrush="{ThemeResource SurfaceDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Quando há atualizações disponíveis -->
                    <Grid Visibility="{x:Bind ViewModel.FlyoutHasUpdatesVisibility, Mode=OneWay}">
                        <!-- Estado normal (quando NÃO está atualizando): botões Atualizar e Abrir -->
                        <Grid ColumnSpacing="8"
                              Visibility="{x:Bind ViewModel.FlyoutNotUpdatingVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="{x:Bind ViewModel.FlyoutUpdateButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.UpdateSelectedCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="34"
                                    Padding="8,0"
                                    FontSize="12" />

                            <Button Grid.Column="1"
                                    Content="Abrir"
                                    Click="OpenButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="34"
                                    Padding="12,0"
                                    FontSize="12.5" />
                        </Grid>

                        <!-- Estado em atualização: Animação viva de ProgressRing + texto de progresso + Botão Cancelar -->
                        <Grid Visibility="{x:Bind ViewModel.IsUpdatingVisibility, Mode=OneWay}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#3B82F6"
                                    CornerRadius="7"
                                    Height="34"
                                    Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ProgressRing Grid.Column="0"
                                                  IsActive="True"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.FlyoutUpdatingButtonText, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind ViewModel.UpdateProgressPercentText, Mode=OneWay}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.CancelUpdatesCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Height="34"
                                    Padding="12,0"
                                    CornerRadius="7"
                                    AutomationProperties.Name="Cancelar atualizações">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                                    <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Botão quando está tudo atualizado: "Verificar agora" ocupando toda a largura -->
                    <Button Content="Verificar agora"
                            Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                            Visibility="{x:Bind ViewModel.FlyoutCleanVisibility, Mode=OneWay}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            FontSize="12.5" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>