<Window
    x:Class="WingetEasy.App.Views.UpdateFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WingetEasy.App.Views.Controls"
    Title="Atualizações Disponíveis">

    <Border x:Name="RootGrid" CornerRadius="12" Loaded="RootGrid_Loaded" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Buscar atualizações"
                         FontSize="14"
                         VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="&#xE72C;"
                            FontFamily="Segoe Fluent Icons"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{x:Bind ViewModel.CheckUpdatesCommand}"/>
                    <Button Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ListView Grid.Row="1"
                      Margin="0,8,0,0"
                      ItemsSource="{x:Bind ViewModel.Packages}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:PackageItemControl/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Footer -->
            <Grid Grid.Row="2" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Grid.Column="1"
                        Content="Atualizar agora"
                        Command="{x:Bind ViewModel.UpdateSelectedCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="140"/>
            </Grid>
        </Grid>
    </Border>
</Window>
