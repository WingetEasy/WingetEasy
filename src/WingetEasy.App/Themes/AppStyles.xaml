        </ResourceDictionary>

        <!-- Tema Claro (Light) -->
        <ResourceDictionary x:Key="Light">
            <!-- Brand & Accent (WingetEasy Design Tokens - Light) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#1F3B82F6" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#F2F3F6FC" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EEF0F4F9" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#EEF0F4F9" />
            <SolidColorBrush x:Key="MainAreaBackgroundBrush" Color="#F2F8FAFC" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#475569" />
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#64748B" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#16A34A" />

            <!-- Navegação e Segmented -->
            <SolidColorBrush x:Key="NavItemHoverBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#DCE5F2" />
            <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SegmentedThumbBrush" Color="#FFFFFF" />

            <!-- Superfícies de Cards e Bordas -->
            <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardSecondaryBackgroundBrush" Color="#EEF1F5F9" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="SurfaceCardStrongBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SurfaceLayerFillBrush" Color="#F8FAFC" />

            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#EEF8FAFC" />
            <SolidColorBrush x:Key="PackageCardBorderBrush" Color="#CBD5E1" />

            <!-- Badges Semânticos (Sucesso, Alerta, Erro) -->
            <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#1F16A34A" />
            <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D16A34A" />

            <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#FFF3E0" />
            <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="BadgeWarningBorderBrush" Color="#66D97706" />

            <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#FFEBEB" />
            <SolidColorBrush x:Key="BadgeErrorFgBrush" Color="#D92D2D" />
            <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#66D92D2D" />

            <!-- Badges de Categorias (Segurança, Runtime, App) -->
            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#FFEBEB" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#D92D2D" />
            <SolidColorBrush x:Key="BadgeSecurityBorderBrush" Color="#66D92D2D" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#FFF3E0" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="BadgeRuntimeBorderBrush" Color="#66D97706" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="BadgeAppFgBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="BadgeAppBorderBrush" Color="#663B82F6" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">12</CornerRadius>

    <LinearGradientBrush x:Key="HeroBannerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A8A" Offset="0.0" />
        <GradientStop Color="#3B82F6" Offset="0.48" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceCardStrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource BrandTextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeroWhiteButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#1E3A8A" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeroGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
