<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Tema Escuro (Default) -->
        <ResourceDictionary x:Key="Default">
            <!-- Brand & Accent (WingetEasy Design Tokens - Dark) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#293B82F6" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#D911151F" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#D9161B26" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#D9161B26" />
            <SolidColorBrush x:Key="MainAreaBackgroundBrush" Color="#D911151F" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#D91C2230" />
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#64748B" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#34D399" />

            <!-- Navegação e Segmented -->
            <SolidColorBrush x:Key="NavItemHoverBrush" Color="#1E2638" />
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#242E42" />
            <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#11151F" />
            <SolidColorBrush x:Key="SegmentedThumbBrush" Color="#242E42" />

            <!-- Superfícies de Cards e Bordas -->
            <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="#CC1C2230" />
            <SolidColorBrush x:Key="SurfaceCardSecondaryBackgroundBrush" Color="#CC232B3D" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#283044" />
            <SolidColorBrush x:Key="SurfaceCardStrongBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#283044" />
            <SolidColorBrush x:Key="SurfaceLayerFillBrush" Color="#11151F" />

            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#CC1C2230" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#CC232B3D" />
            <SolidColorBrush x:Key="PackageCardBorderBrush" Color="#283044" />

            <!-- Badges Semânticos (Sucesso, Alerta, Erro) -->
            <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#2934D399" />
            <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#34D399" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D34D399" />

            <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeWarningBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeErrorFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#66FF6B6B" />

            <!-- Badges de Categorias (Segurança, Runtime, App) -->
            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeSecurityBorderBrush" Color="#66FF6B6B" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeRuntimeBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#1E2E4A" />
            <SolidColorBrush x:Key="BadgeAppFgBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BadgeAppBorderBrush" Color="#663B82F6" />
        </ResourceDictionary>

        <!-- Tema Escuro (Dark) -->
        <ResourceDictionary x:Key="Dark">
            <!-- Brand & Accent (WingetEasy Design Tokens - Dark) -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#293B82F6" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#D911151F" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#D9161B26" />
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#D9161B26" />
            <SolidColorBrush x:Key="MainAreaBackgroundBrush" Color="#D911151F" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#D91C2230" />
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="BrandTextTertiaryBrush" Color="#64747E" />
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#34D399" />

            <!-- Navegação e Segmented -->
            <SolidColorBrush x:Key="NavItemHoverBrush" Color="#1E2638" />
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#242E42" />
            <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#11151F" />
            <SolidColorBrush x:Key="SegmentedThumbBrush" Color="#242E42" />

            <!-- Superfícies de Cards e Bordas -->
            <SolidColorBrush x:Key="SurfaceCardBackgroundBrush" Color="#CC1C2230" />
            <SolidColorBrush x:Key="SurfaceCardSecondaryBackgroundBrush" Color="#CC232B3D" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#283044" />
            <SolidColorBrush x:Key="SurfaceCardStrongBorderBrush" Color="#334155" />
            <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#283044" />
            <SolidColorBrush x:Key="SurfaceLayerFillBrush" Color="#11151F" />

            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#CC1C2230" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#CC232B3D" />
            <SolidColorBrush x:Key="PackageCardBorderBrush" Color="#283044" />

            <!-- Badges Semânticos (Sucesso, Alerta, Erro) -->
            <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#2934D399" />
            <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#34D399" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D34D399" />

            <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeWarningBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeErrorFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#66FF6B6B" />

            <!-- Badges de Categorias (Segurança, Runtime, App) -->
            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BadgeSecurityBorderBrush" Color="#66FF6B6B" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#FFA04A" />
            <SolidColorBrush x:Key="BadgeRuntimeBorderBrush" Color="#66FFA04A" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#1E2E4A" />
