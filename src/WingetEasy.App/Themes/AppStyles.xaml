<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Tema Escuro (Baseado no seu Design) -->
        <ResourceDictionary x:Key="Default">
            <!-- Fundo da linha do pacote (Card) -->
            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#1E1E20" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#2A2A2D" />

            <!-- Badges -->
            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#4A1E1E" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#FF6B6B" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#4A341E" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#FFA04A" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#1E2E4A" />
            <SolidColorBrush x:Key="BadgeAppFgBrush" Color="#4A8BFF" />
        </ResourceDictionary>

        <!-- Tema Claro -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PackageCardBackgroundBrush" Color="#F3F3F5" />
            <SolidColorBrush x:Key="PackageCardHoverBrush" Color="#E5E5E9" />

            <SolidColorBrush x:Key="BadgeSecurityBgBrush" Color="#FFEBEB" />
            <SolidColorBrush x:Key="BadgeSecurityFgBrush" Color="#D92D2D" />

            <SolidColorBrush x:Key="BadgeRuntimeBgBrush" Color="#FFF3E0" />
            <SolidColorBrush x:Key="BadgeRuntimeFgBrush" Color="#D97706" />

            <SolidColorBrush x:Key="BadgeAppBgBrush" Color="#E8F0FE" />
            <SolidColorBrush x:Key="BadgeAppFgBrush" Color="#1A73E8" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
